{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Configure macOS keyboard shortcuts and system preferences
set -euo pipefail

echo "==> Configuring macOS keyboard shortcuts..."

# Remap "Move focus to next window" from Cmd+` to Option+Tab
# Key 27 = Move focus to next window
# Parameters: (charCode, keyCode, modifierFlags)
# Tab = 48 (keycode), 9 (charcode), 524288 (Option modifier)
defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys -dict-add 27 \
  '{ enabled = 1; value = { parameters = (9, 48, 524288); type = standard; }; }'

echo "==> Configuring Rectangle..."

# Use Spectacle-style default shortcuts
defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool true
# Allow any shortcut (not just modifiers + arrow keys)
defaults write com.knollsoft.Rectangle allowAnyShortcut -bool true
# Cycle through sizes on repeated execution (half -> two-thirds -> one-third)
defaults write com.knollsoft.Rectangle subsequentExecutionMode -int 1
# Disable auto-update checks (managed via Homebrew)
defaults write com.knollsoft.Rectangle SUEnableAutomaticChecks -bool false

# Custom shortcuts:
# Ctrl+Option+H/J/K/L = left/bottom/top/right half
defaults write com.knollsoft.Rectangle leftHalf -dict keyCode -int 4 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle bottomHalf -dict keyCode -int 38 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle topHalf -dict keyCode -int 40 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle rightHalf -dict keyCode -int 37 modifierFlags -int 786432

# Ctrl+Option+U/O/M/. = top-left/top-right/bottom-left/bottom-right
defaults write com.knollsoft.Rectangle topLeft -dict keyCode -int 32 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle topRight -dict keyCode -int 31 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle bottomLeft -dict keyCode -int 46 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle bottomRight -dict keyCode -int 47 modifierFlags -int 786432

# Ctrl+Option+C/F = center/maximize
defaults write com.knollsoft.Rectangle center -dict keyCode -int 8 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle maximize -dict keyCode -int 3 modifierFlags -int 786432
# Move Rectangle's extra center-ish defaults away from Ctrl+Option+F so maximize wins.
defaults write com.knollsoft.Rectangle centerThird -dict keyCode -int 17 modifierFlags -int 917504
defaults write com.knollsoft.Rectangle centerHalf -dict keyCode -int 8 modifierFlags -int 917504
defaults write com.knollsoft.Rectangle almostMaximize -dict keyCode -int 3 modifierFlags -int 917504

# Ctrl+Option+I/, = next/previous display
defaults write com.knollsoft.Rectangle nextDisplay -dict keyCode -int 34 modifierFlags -int 786432
defaults write com.knollsoft.Rectangle previousDisplay -dict keyCode -int 43 modifierFlags -int 786432

# Ctrl+Option+B = Toggle Todo (keyCode 11 = B, modifierFlags 786432 = Ctrl+Option)
defaults write com.knollsoft.Rectangle toggleTodo -dict keyCode -int 11 modifierFlags -int 786432
# Ctrl+Option+N = Reflow Todo (keyCode 45 = N, modifierFlags 786432 = Ctrl+Option)
defaults write com.knollsoft.Rectangle reflowTodo -dict keyCode -int 45 modifierFlags -int 786432

# Launch the package-managed apps and register their login items. A GUI or MDM
# restriction should not abort the rest of a dotfile apply.
if [[ -d /Applications/Rectangle.app ]]; then
    open -a Rectangle || echo "    WARNING: Could not launch Rectangle."
    osascript -e 'tell application "System Events" to if not (exists login item "Rectangle") then make login item at end with properties {name:"Rectangle", path:"/Applications/Rectangle.app", hidden:true}' \
        || echo "    WARNING: Could not register Rectangle as a login item."
else
    echo "    WARNING: Rectangle is not installed; re-run the package phase."
fi

if [[ -d /Applications/Hammerspoon.app ]]; then
    open -a Hammerspoon || echo "    WARNING: Could not launch Hammerspoon."
    osascript -e 'tell application "System Events" to if not (exists login item "Hammerspoon") then make login item at end with properties {name:"Hammerspoon", path:"/Applications/Hammerspoon.app", hidden:true}' \
        || echo "    WARNING: Could not register Hammerspoon as a login item."
else
    echo "    WARNING: Hammerspoon is not installed; re-run the package phase."
fi

echo "==> macOS configuration done. Log out and back in for shortcut changes to take effect."
{{ end -}}
