{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/claude-sonnet-4.6",
  "provider": {
    "anthropic": {
      "options": { "timeout": 600000 }
    }
  },
  "permission": {
    "external_directory": {
      "{{ .chezmoi.homeDir }}/.ai/*": "allow",
      "{{ .chezmoi.homeDir }}/.config/opencode/agents/*": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "remote",
      "url": "http://localhost:8931/mcp"
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"]
    },
    "grep_app": {
      "type": "local",
      "command": ["node", "{{ .chezmoi.homeDir }}/.local/share/grep_app_mcp/dist/server-stdio.js"]
    }
  }
}
