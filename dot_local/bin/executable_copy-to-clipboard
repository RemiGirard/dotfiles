#!/usr/bin/env sh
# Copy stdin to the native clipboard on macOS, Wayland, or X11.
set -eu

if command -v pbcopy >/dev/null 2>&1; then
    exec pbcopy
elif command -v wl-copy >/dev/null 2>&1; then
    exec wl-copy
elif command -v xclip >/dev/null 2>&1; then
    exec xclip -selection clipboard
fi

echo "copy-to-clipboard: no supported clipboard command found" >&2
exit 1
