#!/usr/bin/env bash
# git-wt: git worktree helper with tmux session integration
# Usage:
#   git wt add <branch> [--port PORT]  - Create worktree + tmux session
#   git wt list                        - List worktrees with session status
#   git wt switch                      - Fuzzy-find and switch to a worktree session
#   git wt rm <branch>                 - Remove worktree + kill tmux session
#   git wt clean                       - Remove all merged worktrees

set -euo pipefail

cmd="${1:-help}"
shift || true

# Get repo root and name
repo_root=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [[ -z "$repo_root" ]]; then
    echo "Not in a git repository"
    exit 1
fi
repo_name=$(basename "$repo_root")

branch_slug() {
    # Slashes are path separators, so map them to hyphens for sibling
    # worktree directories. Git already rejects whitespace and other unsafe
    # branch-name characters.
    printf '%s' "$1" | tr '/' '-'
}

session_name_for_path() {
    basename "$1" | tr '.' '_' | tr '/' '-'
}

find_worktree_for_branch() {
    local target_ref="refs/heads/$1"
    local candidate_path=""
    local candidate_branch=""

    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            "worktree "*)
                candidate_path="${line#worktree }"
                candidate_branch=""
                ;;
            "branch "*)
                candidate_branch="${line#branch }"
                if [[ "$candidate_branch" == "$target_ref" ]]; then
                    printf '%s\n' "$candidate_path"
                    return 0
                fi
                ;;
        esac
    done < <(git worktree list --porcelain)

    return 1
}

case "$cmd" in
    add)
        branch="${1:?Usage: git wt add <branch> [--port PORT]}"
        shift || true
        PORT="${PORT:-3000}"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --port)
                    if [[ $# -lt 2 ]]; then
                        echo "Usage: git wt add <branch> [--port PORT]" >&2
                        exit 2
                    fi
                    PORT="$2"
                    shift 2
                    ;;
                *)      shift ;;
            esac
        done

        if worktree_path=$(find_worktree_for_branch "$branch"); then
            echo "Worktree already exists at $worktree_path"
        else
            slug=$(branch_slug "$branch")
            worktree_path="${repo_root}-${slug}"
            if [[ -e "$worktree_path" ]]; then
                echo "Path already exists and is not the '$branch' worktree: $worktree_path" >&2
                exit 1
            fi

            if git show-ref --verify --quiet "refs/heads/$branch"; then
                git worktree add "$worktree_path" "$branch"
            elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
                git worktree add -b "$branch" --track "$worktree_path" "origin/$branch"
            else
                git worktree add "$worktree_path" -b "$branch"
            fi
            echo "Created worktree: $worktree_path"
        fi

        # Create tmux session
        session_name=$(session_name_for_path "$worktree_path")

        if tmux has-session -t="$session_name" 2>/dev/null; then
            echo "Session '$session_name' already exists"
        else
            tmux-project "$worktree_path" --port "$PORT"
        fi
        ;;

    list|ls)
        echo "Worktrees for $repo_name:"
        echo ""
        git worktree list | while read -r path _commit branch; do
            session_name=$(session_name_for_path "$path")
            if tmux has-session -t="$session_name" 2>/dev/null; then
                status="[tmux: active]"
            else
                status=""
            fi
            printf "  %-40s %s %s\n" "$path" "$branch" "$status"
        done
        ;;

    switch|sw)
        if ! worktree=$(git worktree list --porcelain \
            | sed -n 's/^worktree //p' \
            | fzf --prompt="worktree> " --height=40% --border --reverse); then
            exit 0
        fi
        if [[ -n "$worktree" ]]; then
            session_name=$(session_name_for_path "$worktree")

            if ! tmux has-session -t="$session_name" 2>/dev/null; then
                tmux-project "$worktree"
            else
                if [[ -z "${TMUX:-}" ]]; then
                    tmux attach -t "$session_name"
                else
                    tmux switch-client -t "$session_name"
                fi
            fi
        fi
        ;;

    rm|remove)
        branch="${1:?Usage: git wt rm <branch>}"
        if ! worktree_path=$(find_worktree_for_branch "$branch"); then
            echo "No worktree registered for branch '$branch'" >&2
            exit 1
        fi
        session_name=$(session_name_for_path "$worktree_path")

        # Keep the session alive if Git refuses a dirty or otherwise unsafe
        # removal. Only tear it down after the worktree is gone.
        if git worktree remove -- "$worktree_path"; then
            tmux kill-session -t "$session_name" 2>/dev/null || true
            echo "Removed worktree: $worktree_path"
        else
            echo "Worktree not removed: $worktree_path" >&2
            exit 1
        fi
        ;;

    clean)
        echo "Cleaning merged worktrees..."
        if git show-ref --verify --quiet refs/heads/main; then
            base_ref="refs/heads/main"
        elif git show-ref --verify --quiet refs/heads/master; then
            base_ref="refs/heads/master"
        else
            echo "No local main or master branch found; refusing to clean." >&2
            exit 1
        fi

        remove_if_merged() {
            local path="$1" branch_ref="$2"
            [[ -n "$path" && "$path" != "$repo_root" ]] || return 0
            [[ "$branch_ref" == refs/heads/* ]] || return 0
            [[ "$branch_ref" != "$base_ref" ]] || return 0
            git show-ref --verify --quiet "$branch_ref" || return 0
            git merge-base --is-ancestor "$branch_ref" "$base_ref" || return 0

            local branch_name="${branch_ref#refs/heads/}"
            local session_name
            session_name=$(session_name_for_path "$path")
            if git worktree remove -- "$path" 2>/dev/null; then
                tmux kill-session -t "$session_name" 2>/dev/null || true
                echo "  Removed: $path ($branch_name)"
            fi
        }

        worktree_path=""
        branch_ref=""
        while IFS= read -r line || [[ -n "$line" ]]; do
            case "$line" in
                "worktree "*)
                    remove_if_merged "$worktree_path" "$branch_ref"
                    worktree_path="${line#worktree }"
                    branch_ref=""
                    ;;
                "branch "*)
                    branch_ref="${line#branch }"
                    ;;
                "")
                    remove_if_merged "$worktree_path" "$branch_ref"
                    worktree_path=""
                    branch_ref=""
                    ;;
            esac
        done < <(git worktree list --porcelain)
        remove_if_merged "$worktree_path" "$branch_ref"
        git worktree prune
        echo "Done."
        ;;

    help|*)
        echo "git-wt: worktree + tmux session manager"
        echo ""
        echo "Usage:"
        echo "  git wt add <branch> [--port PORT]  Create worktree + tmux session"
        echo "  git wt list                        List worktrees with session status"
        echo "  git wt switch                      Fuzzy-find and switch to worktree"
        echo "  git wt rm <branch>                 Remove worktree + kill session"
        echo "  git wt clean                       Remove all merged worktrees"
        ;;
esac
