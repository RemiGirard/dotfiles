#!/usr/bin/env bash
# tmux-project: prepare a dev session with predefined empty windows
# Usage: tmux-project [path] [--port PORT]
#
# Creates empty tmux windows named editor, server, docker (when a Compose file
# exists), agent, and term. Commands are intentionally left for you to start.
# PORT is exported when the session and its window shells are created.

set -euo pipefail

PORT="${PORT:-3000}"
port_explicit=0
selected=""

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        --port)
            if [[ $# -lt 2 ]]; then
                echo "Usage: tmux-project [path] [--port PORT]" >&2
                exit 2
            fi
            PORT="$2"
            port_explicit=1
            shift 2
            ;;
        *)      selected="$1"; shift ;;
    esac
done

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/Projects}"

if [[ -z "$selected" ]]; then
    if ! selected=$(project-roots "$PROJECTS_DIR" \
        | fzf --prompt="project> " --height=40% --border --reverse); then
        exit 0
    fi
fi

if [[ -z "$selected" ]]; then
    exit 0
fi

session_name=$(basename "$selected" | tr '.' '_')

# If session already exists, just attach to it
if tmux has-session -t="$session_name" 2>/dev/null; then
    if [[ "$port_explicit" -eq 1 ]]; then
        existing_port=$(tmux show-environment -t "$session_name" PORT 2>/dev/null || true)
        existing_port="${existing_port#PORT=}"
        if [[ "$existing_port" != "$PORT" ]]; then
            echo "Session '$session_name' already exists with PORT=${existing_port:-unset}; existing pane environments were not changed." >&2
        fi
    fi
    if [[ -z "${TMUX:-}" ]]; then
        tmux attach -t "$session_name"
    else
        tmux switch-client -t "$session_name"
    fi
    exit 0
fi

# Window 1: editor. -e sets PORT before tmux starts any window shells.
tmux new-session -d -s "$session_name" -c "$selected" -n "editor" -e "PORT=$PORT"

# Window 2: server
tmux new-window -t "$session_name" -c "$selected" -n "server"

# Window 3: docker (only if docker-compose exists)
if [[ -f "$selected/docker-compose.yml" ]] || [[ -f "$selected/docker-compose.yaml" ]] || [[ -f "$selected/compose.yml" ]] || [[ -f "$selected/compose.yaml" ]]; then
    tmux new-window -t "$session_name" -c "$selected" -n "docker"
fi

# Window 4: AI agent
tmux new-window -t "$session_name" -c "$selected" -n "agent"

# Window 5: terminal
tmux new-window -t "$session_name" -c "$selected" -n "term"

# Go back to editor window
tmux select-window -t "$session_name:editor"

# Attach or switch
if [[ -z "${TMUX:-}" ]]; then
    tmux attach -t "$session_name"
else
    tmux switch-client -t "$session_name"
fi
